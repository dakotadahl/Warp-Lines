# Normalize line endings for consistent builds and diffs
* text=auto eol=lf

# Scripts and source (force LF)
*.js text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.svg text eol=lf

# Binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
